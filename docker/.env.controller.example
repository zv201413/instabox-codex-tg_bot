# Copy to .env.controller, chmod 600, then replace placeholders.
INSTABOX_API_KEY=YOUR_INSTABOX_API_KEY
INSTABOX_MACHINE_ID=YOUR_MACHINE_ID
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_ALLOWED_USERS=YOUR_TELEGRAM_USER_ID
AGENT_API_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AGENT_ID=codex-bridge
# gateway: same conversation bot, only VPS polls getUpdates.
# control_only: separate machine-control bot, original conversation bot is unchanged.
# Same conversation bot; stop the Bridge's old getUpdates before starting the Controller.
TELEGRAM_GATEWAY_MODE=gateway
INSTABOX_KEEP_MODE=manual
INSTABOX_LEASE_NAME=tg-controller
INSTABOX_LEASE_TTL=300
INSTABOX_RENEW_EVERY=120
INSTABOX_AUTO_START=0
HOLD_WINDOW_MINUTES=60
MAX_HOLD_MINUTES=480
WAKE_REQUEST_SECONDS=86400
SCHEDULE_WINDOW=09:00-18:00
SCHEDULE_DAYS=0,1,2,3,4
SCHEDULE_WAKE=0
TZ=Asia/Shanghai
